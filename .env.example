# Copy to .env and fill in. Every setting can also be changed later in the web UI, except the ones marked (env only).
# HAMSTRA_* is the preferred prefix; the older ARR_* names still work.

# TMDB "API Read Access Token" (free, themoviedb.org/settings/api). Needed for movie search.
HAMSTRA_TMDB_API_KEY=

# Lets scripts call the API with an X-Api-Key header. The web UI uses accounts instead. Use a long random string.
HAMSTRA_API_KEY=change-me

# Folders as the app sees them (inside the container). Also editable under Settings -> Library -> Media folders.
HAMSTRA_TV_ROOT=/media/tv
HAMSTRA_MOVIES_KIDS_ROOT=/media/movies/kids
HAMSTRA_MOVIES_ADULTS_ROOT=/media/movies/adults
HAMSTRA_MUSIC_ROOT=/media/music
# Everything downloads here first. Keep it on the same share as the library.
HAMSTRA_DOWNLOADS_DIR=/media/downloads

# hardlink | move | copy. Falls back to a size-checked copy where hardlinks are impossible (SMB/NFS shares).
HAMSTRA_IMPORT_MODE=hardlink

# Stop grabbing when the download folder has less free space than this (GB). 0 disables the check.
HAMSTRA_MIN_FREE_GB=20

# Set to true when the app is served over HTTPS (reverse proxy).
HAMSTRA_SECURE_COOKIES=false

# Where the database, backups and torrent state live (env only). The container image already sets /config.
# HAMSTRA_DATA_DIR=/config
